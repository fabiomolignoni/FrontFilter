{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "3.0.1",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "homepage_url": "https://github.com/fabiomolignoni/FrontFilter",
  "permissions": [
    "storage",
    "declarativeNetRequestWithHostAccess",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "*://*.reddit.com/*"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png",
      "256": "icons/icon-256.png",
      "512": "icons/icon-512.png"
    },
    "default_title": "FrontFilter",
    "default_popup": "popup/index.html"
  },
  "options_ui": {
    "page": "popup/index.html?standalone=true",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.reddit.com/*"
      ],
      "js": ["content/feed-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.reddit.com/*"
      ],
      "js": [
        "shared/core.js",
        "shared/i18n.js",
        "shared/stats.js",
        "content/selectors.js",
        "content/posts.js",
        "content/page-style.js",
        "content/autoplay.js",
        "content/feed-tabs.js",
        "content/feed-window.js",
        "content/limit-view.js",
        "content/feed-limit.js",
        "content/comment-limit.js",
        "content/quick-block.js",
        "content/stats-recorder.js",
        "content/main.js"
      ],
      "css": ["content/feed-limit.css", "content/quick-block.css"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["blocked/index.html"],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png",
    "256": "icons/icon-256.png",
    "512": "icons/icon-512.png"
  },
  "minimum_chrome_version": "121"
}
