{
  "name": "frontfilter",
  "private": true,
  "description": "Tests and packaging for the FrontFilter browser extension",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/unit/*.test.js",
    "build": "npm test && python3 scripts/package.py",
    "test:chrome": "python3 tests/browser/chrome.py",
    "test:firefox": "python3 tests/browser/firefox.py",
    "test:reddit": "python3 tests/reddit/canary.py"
  }
}
